# Every minute at :33 seconds. Moved from :05 on 2026-11-04: at :05 (+6s sleep) it held bridge
# 18815 across the :07 cluster of hourly jobs and starved zigzag-trail-switch for 8 hours.
# Others: xau-advisor :20 (15-min), trail-runner :40, zigzag-trail-watch :50.
[Unit]
Description=Every-minute XAUUSD advisor executor (Switch 360602)
[Timer]
OnCalendar=*-*-* *:*:33
Persistent=false
AccuracySec=5s
Unit=xau-advisor-trader.service
[Install]
WantedBy=timers.target
